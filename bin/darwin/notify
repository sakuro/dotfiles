#!/bin/bash
set -euo pipefail

# Usage:
#   notify "Title" "Body"
#   notify "Title"                 # body omitted

title="${1:-Notification}"
body="${2:-}"

if command -v osascript >/dev/null 2>&1; then
  osascript -e "display notification \"${body}\" with title \"${title}\"" >/dev/null
  exit 0
fi

printf "\a%s: %s\n" "${title}" "${body}" >&2
exit 2
