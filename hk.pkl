amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"
import "package://github.com/sakuro/git-hooks/releases/download/v0.3.0/git-hooks@0.3.0#/Steps.pkl" as GitHooks

hooks {
  ["commit-msg"] {
    steps {
      ["emoji-enforced"] = GitHooks.emoji_enforced
    }
  }
  ["prepare-commit-msg"] {
    steps {
      ["merge-prefix"] = GitHooks.merge_prefix
    }
  }
  ["pre-commit"] {
    steps {
      ["gitleaks"] = Builtins.gitleaks
    }
  }
  ["pre-push"] {
    steps {
      ["case-conflict"] = Builtins.check_case_conflict
      ["newlines"] = Builtins.newlines
    }
  }
  ["post-merge"] {
    steps {
      ["sync-dotfiles"] {
        check = #"""
          mise bootstrap dotfiles apply --quiet
          mise install
          mise prune --yes
          """#
      }
    }
  }
}
